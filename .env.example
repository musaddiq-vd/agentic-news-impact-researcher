# Copy this file to .env and fill in the values. Never commit .env.

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tavily
TAVILY_API_KEY=

# Bedrock model IDs (confirm exact IDs in the Bedrock console)
MODEL_QUERY=
MODEL_IMPACT=
MODEL_SUMMARY=

# Limits
MAX_ARTICLES=8
DAYS=30

# SQLite
DB_PATH=news_impact.db

# Address of the FastAPI backend (used by the Streamlit UI)
API_URL=http://127.0.0.1:8000

# Articles analysed at the same time by impact_analyzer (raise only if Bedrock does not throttle)
IMPACT_CONCURRENCY=3

# Colored agent log lines in the API terminal (0 to turn off)
TRACE_LOGS=1

# Daily email brief (python -m app.brief). For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated recipients
BRIEF_TO=
# Link in the email to open the app
APP_URL=http://localhost:8501
